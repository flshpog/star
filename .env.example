# Copy this file to .env and fill in your values.

# Your bot's token (Bot tab in the Discord developer portal). Keep it secret!
BOT_TOKEN=

# Your application / client ID (General Information tab on the dev portal).
CLIENT_ID=

# Optional: a server ID for INSTANT command updates while testing.
# Leave blank to only register global commands (these can take ~1h to appear).
GUILD_ID=
